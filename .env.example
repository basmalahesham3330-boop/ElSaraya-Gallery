# ==================================================================
# ERP Backend - Environment Configuration
# ==================================================================
# Copy this file to .env and update with your actual values
# 
# SECURITY WARNING: Never commit .env to version control!
# This file contains sensitive credentials.
# ==================================================================

# ------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------
APP_NAME=ERP Backend
# Environment: development, staging, production
APP_ENV=production
# Enable debug mode (set to false in production)
APP_DEBUG=false
# API version prefix
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------
# Database credentials - GENERATE A SECURE PASSWORD!
# Use: openssl rand -base64 24
# Or PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 24 | % {[char]$_})
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD_MIN_24_CHARS
POSTGRES_DB=erp_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full async SQLAlchemy connection string (used by the application)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://erp_user:CHANGE_THIS_TO_SECURE_PASSWORD_MIN_24_CHARS@db:5432/erp_db

# Sync connection string (used by Alembic migrations)
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL_SYNC=postgresql+psycopg://erp_user:CHANGE_THIS_TO_SECURE_PASSWORD_MIN_24_CHARS@db:5432/erp_db

# ------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------
# Server host (0.0.0.0 allows external connections)
HOST=0.0.0.0
# Server port
PORT=8000

# ------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------
# Comma-separated list of allowed origins for frontend access
# Add your production domains here
# Example: CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------
# Production Deployment Notes
# ------------------------------------------------------------------
# 1. Generate strong passwords for POSTGRES_PASSWORD (min 16 chars)
# 2. Update DATABASE_URL and DATABASE_URL_SYNC with the new password
# 3. Set APP_DEBUG=false in production
# 4. Set APP_ENV=production
# 5. Configure CORS_ORIGINS for your frontend domain
# 6. Consider using secrets management (Docker secrets, vault, etc.)
# ==================================================================
